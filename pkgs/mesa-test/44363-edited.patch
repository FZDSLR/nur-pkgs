From 039911e2e4a13a3191c8f8fe92aa9f78770f62af Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lo=C3=AFc=20Molinari?= <loic.molinari@collabora.com>
Date: Thu, 10 Sep 2026 14:40:36 +0200
Subject: [PATCH 3/3] panfrost: Flush AFBC-P compute jobs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

We can safely flush the AFBC-P compute jobs now that update is called
outside of a draw call.

Signed-off-by: Loïc Molinari <loic.molinari@collabora.com>
---
 src/gallium/drivers/panfrost/pan_resource.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/gallium/drivers/panfrost/pan_resource.c b/src/gallium/drivers/panfrost/pan_resource.c
index dab9f3681f62..461a05886f89 100644
--- a/src/gallium/drivers/panfrost/pan_resource.c
+++ b/src/gallium/drivers/panfrost/pan_resource.c
@@ -2004,6 +2004,8 @@ pan_resource_afbcp_get_payload_sizes(struct panfrost_context *ctx,
       screen->vtbl.afbc_size(batch, prsrc, prsrc->afbcp->layout_bo,
                              prsrc->afbcp->layout_offsets[level], level);
 
+   panfrost_flush_batches_accessing_rsrc(ctx, prsrc,
+                                         "AFBC-P payload sizes compute job");
    prsrc->afbcp->skip_access_updates = false;
 
    return true;
@@ -2152,6 +2154,8 @@ pan_resource_afbcp_pack(struct panfrost_context *ctx,
                              prsrc->afbcp->layout_bo,
                              prsrc->afbcp->layout_offsets[level], level);
 
+   panfrost_flush_batches_accessing_rsrc(ctx, prsrc,
+                                         "AFBC-P packing compute job");
    prsrc->afbcp->skip_access_updates = false;
 
    return true;
-- 
