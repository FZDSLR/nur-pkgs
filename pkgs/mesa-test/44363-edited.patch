From 40be52c7d19e448f671e6526d4ee35d9c936327c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lo=C3=AFc=20Molinari?= <loic.molinari@collabora.com>
Date: Thu, 10 Sep 2026 14:15:55 +0200
Subject: [PATCH 2/3] panfrost: Defer resource updates at the end of draw calls
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Resource update is used to let resources know that they're being used
by a draw call. It's currently only used for AFBC packing. The issue
is that it's currently called while a draw call is being emitted and
it prevents the update handler from flushing the current batch. Doing
so results in a crash because the batch is submitted and when the draw
call continues it expects the batch to be in the state it was before
the update.

This commit propose to queue the resources at draw call dependency
handling and update them at the end of the draw call when all the
batches can be safely submitted.

Signed-off-by: Loïc Molinari <loic.molinari@collabora.com>
---
 src/gallium/drivers/panfrost/pan_cmdstream.c |  8 ++++++
 src/gallium/drivers/panfrost/pan_context.h   |  7 +++++
 src/gallium/drivers/panfrost/pan_job.c       | 28 +++++++++++++++++---
 src/gallium/drivers/panfrost/pan_job.h       |  5 ++++
 4 files changed, 44 insertions(+), 4 deletions(-)

diff --git a/src/gallium/drivers/panfrost/pan_cmdstream.c b/src/gallium/drivers/panfrost/pan_cmdstream.c
index 6629934fecdf..7efd95891c39 100644
--- a/src/gallium/drivers/panfrost/pan_cmdstream.c
+++ b/src/gallium/drivers/panfrost/pan_cmdstream.c
@@ -3675,6 +3675,10 @@ panfrost_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
    } else {
       panfrost_multi_draw_direct(pipe, info, drawid_offset, draws, num_draws);
    }
+
+   /* Update once the draw call is pushed so that resources can safely push
+    * more calls. */
+   panfrost_update_rsrcs(ctx);
 }
 
 /* Launch grid is the compute equivalent of draw_vbo, so in this routine, we
diff --git a/src/gallium/drivers/panfrost/pan_context.h b/src/gallium/drivers/panfrost/pan_context.h
index 75e72ab6c777..9c5c8da7abc6 100644
--- a/src/gallium/drivers/panfrost/pan_context.h
+++ b/src/gallium/drivers/panfrost/pan_context.h
@@ -36,6 +36,9 @@
 
 #include "pan_csf.h"
 
+/* XXX Figure out correct number */
+#define PAN_MAX_RSRCS_PER_DRAW 1024
+
 #define SET_BIT(lval, bit, cond)                                               \
    if (cond)                                                                   \
       lval |= (bit);                                                           \
@@ -143,6 +146,10 @@ struct panfrost_context {
       BITSET_DECLARE(active, PAN_MAX_BATCHES);
    } batches;
 
+   /* Resources accessed per draw call (read/write). */
+   unsigned nr_rsrcs[2];
+   struct panfrost_resource *rsrcs[2][PAN_MAX_RSRCS_PER_DRAW];
+
    /* Map from resources to panfrost_batches */
    struct hash_table *writers;
 
diff --git a/src/gallium/drivers/panfrost/pan_job.c b/src/gallium/drivers/panfrost/pan_job.c
index 6dfde4e2933d..119abb1bae97 100644
--- a/src/gallium/drivers/panfrost/pan_job.c
+++ b/src/gallium/drivers/panfrost/pan_job.c
@@ -238,6 +238,28 @@ panfrost_get_fresh_batch_for_fbo(struct panfrost_context *ctx,
    return batch;
 }
 
+void
+panfrost_add_rsrc(struct panfrost_context *ctx,
+                  struct panfrost_resource *rsrc, bool writes)
+{
+   assert(ctx->nr_rsrcs[writes] < PAN_MAX_RSRCS_PER_DRAW);
+
+   ctx->rsrcs[writes][ctx->nr_rsrcs[writes]++] = rsrc;
+}
+
+void
+panfrost_update_rsrcs(struct panfrost_context *ctx)
+{
+   for (int i = 0; i < ctx->nr_rsrcs[0]; i++)
+      pan_resource_update_access(ctx, ctx->rsrcs[0][i], false);
+
+   for (int i = 0; i < ctx->nr_rsrcs[1]; i++)
+      pan_resource_update_access(ctx, ctx->rsrcs[1][i], true);
+
+   ctx->nr_rsrcs[0] = 0;
+   ctx->nr_rsrcs[1] = 0;
+}
+
 static bool panfrost_batch_uses_resource(struct panfrost_batch *batch,
                                          struct panfrost_resource *rsrc);
 
@@ -280,6 +302,8 @@ panfrost_batch_update_access(struct panfrost_batch *batch,
             panfrost_batch_submit(ctx, other_batch);
       }
    }
+
+   panfrost_add_rsrc(ctx, rsrc, writes);
 }
 
 static pan_bo_access *
@@ -366,8 +390,6 @@ panfrost_batch_read_rsrc(struct panfrost_batch *batch,
 {
    uint32_t access = PAN_BO_ACCESS_READ | panfrost_access_for_stage(stage);
 
-   pan_resource_update_access(batch->ctx, rsrc, false);
-
    panfrost_batch_add_bo_old(batch, rsrc->bo, access);
 
    if (rsrc->separate_stencil)
@@ -385,8 +407,6 @@ panfrost_batch_write_rsrc(struct panfrost_batch *batch,
 {
    uint32_t access = PAN_BO_ACCESS_WRITE | panfrost_access_for_stage(stage);
 
-   pan_resource_update_access(batch->ctx, rsrc, true);
-
    panfrost_batch_add_bo_old(batch, rsrc->bo, access);
 
    if (rsrc->separate_stencil)
diff --git a/src/gallium/drivers/panfrost/pan_job.h b/src/gallium/drivers/panfrost/pan_job.h
index 4e47406ac119..ba67cb97fe2e 100644
--- a/src/gallium/drivers/panfrost/pan_job.h
+++ b/src/gallium/drivers/panfrost/pan_job.h
@@ -254,4 +254,9 @@ panfrost_has_fragment_job(struct panfrost_batch *batch)
    return batch->draw_count > 0 || batch->clear;
 }
 
+void panfrost_add_rsrc(struct panfrost_context *ctx,
+                       struct panfrost_resource *rsrc, bool writes);
+
+void panfrost_update_rsrcs(struct panfrost_context *ctx);
+
 #endif
-- 
