From bda664ba3405100f7ccba8b3958c14a893830ab7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lo=C3=AFc=20Molinari?= <loic.molinari@collabora.com>
Date: Thu, 3 Sep 2026 16:56:04 +0200
Subject: [PATCH 1/3] panfrost: Log AFBC-P messages at debug level (not warn)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Use mesa_logd() directly instead of trying to copy perf_debug() which
is meant to support GL debug output. The warnings were also cluttering
CI output when AFBC-P is enabled.

Signed-off-by: Loïc Molinari <loic.molinari@collabora.com>
---
 src/gallium/drivers/panfrost/pan_resource.c | 31 ++++++++++-----------
 src/gallium/drivers/panfrost/pan_screen.h   |  7 -----
 2 files changed, 14 insertions(+), 24 deletions(-)

diff --git a/src/gallium/drivers/panfrost/pan_resource.c b/src/gallium/drivers/panfrost/pan_resource.c
index 178b7b8a5624..dab9f3681f62 100644
--- a/src/gallium/drivers/panfrost/pan_resource.c
+++ b/src/gallium/drivers/panfrost/pan_resource.c
@@ -1961,12 +1961,11 @@ pan_resource_afbcp_get_payload_sizes(struct panfrost_context *ctx,
 {
    PAN_TRACE_FUNC(PAN_TRACE_GL_RESOURCE);
 
-   afbcp_debug(ctx,
-               "AFBC-P prsrc=%p: Get payload sizes (reads=%u bo_size=%zu, gpu=%s)",
-               prsrc, prsrc->afbcp->nr_consecutive_reads,
-               panfrost_bo_size(prsrc->bo),
-               pan_screen(ctx->base.screen)->afbcp_gpu_payload_sizes ?
-               "true" : "false");
+   mesa_logd("AFBC-P prsrc=%p: Get payload sizes (reads=%u bo_size=%zu, gpu=%s)",
+             prsrc, prsrc->afbcp->nr_consecutive_reads,
+             panfrost_bo_size(prsrc->bo),
+             pan_screen(ctx->base.screen)->afbcp_gpu_payload_sizes ?
+             "true" : "false");
 
    struct panfrost_screen *screen = pan_screen(ctx->base.screen);
    struct panfrost_device *dev = pan_device(ctx->base.screen);
@@ -2062,10 +2061,9 @@ pan_resource_afbcp_get_payload_offsets(struct panfrost_context *ctx,
 {
    PAN_TRACE_FUNC(PAN_TRACE_GL_RESOURCE);
 
-   afbcp_debug(ctx,
-               "AFBC-P prsrc=%p: Get payload offsets (reads=%u bo_size=%zu)",
-               prsrc, prsrc->afbcp->nr_consecutive_reads,
-               panfrost_bo_size(prsrc->bo));
+   mesa_logd("AFBC-P prsrc=%p: Get payload offsets (reads=%u bo_size=%zu)",
+             prsrc, prsrc->afbcp->nr_consecutive_reads,
+             panfrost_bo_size(prsrc->bo));
 
    struct panfrost_device *dev = pan_device(ctx->base.screen);
    uint64_t modifier = prsrc->modifier;
@@ -2119,9 +2117,9 @@ pan_resource_afbcp_pack(struct panfrost_context *ctx,
 {
    PAN_TRACE_FUNC(PAN_TRACE_GL_RESOURCE);
 
-   afbcp_debug(ctx, "AFBC-P prsrc=%p: Pack (reads=%u bo_size=%zu ratio=%.2f)",
-               prsrc, prsrc->afbcp->nr_consecutive_reads,
-               panfrost_bo_size(prsrc->bo), prsrc->afbcp->ratio);
+   mesa_logd("AFBC-P prsrc=%p: Pack (reads=%u bo_size=%zu ratio=%.2f)", prsrc,
+             prsrc->afbcp->nr_consecutive_reads, panfrost_bo_size(prsrc->bo),
+             prsrc->afbcp->ratio);
 
    struct panfrost_screen *screen = pan_screen(ctx->base.screen);
    struct panfrost_device *dev = pan_device(ctx->base.screen);
@@ -2166,10 +2164,9 @@ pan_resource_afbcp_commit(struct panfrost_context *ctx,
 {
    PAN_TRACE_FUNC(PAN_TRACE_GL_RESOURCE);
 
-   afbcp_debug(ctx,
-               "AFBC-P prsrc=%p: Commit (reads=%u bo_size=%zu ratio=%.2f)",
-               prsrc, prsrc->afbcp->nr_consecutive_reads,
-               panfrost_bo_size(prsrc->bo), prsrc->afbcp->ratio);
+   mesa_logd("AFBC-P prsrc=%p: Commit (reads=%u bo_size=%zu ratio=%.2f)",
+             prsrc, prsrc->afbcp->nr_consecutive_reads,
+             panfrost_bo_size(prsrc->bo), prsrc->afbcp->ratio);
 
    uint64_t modifier = prsrc->modifier & ~AFBC_FORMAT_MOD_SPARSE;
    assert(!panfrost_is_emulated_mod(modifier));
diff --git a/src/gallium/drivers/panfrost/pan_screen.h b/src/gallium/drivers/panfrost/pan_screen.h
index b04c607d99f1..76902c84dbb5 100644
--- a/src/gallium/drivers/panfrost/pan_screen.h
+++ b/src/gallium/drivers/panfrost/pan_screen.h
@@ -202,11 +202,4 @@ void panfrost_cmdstream_screen_init_v14(struct panfrost_screen *screen);
       util_debug_message(&ctx->base.debug, PERF_INFO, __VA_ARGS__);            \
    } while (0)
 
-#define afbcp_debug(ctx, ...)                                                  \
-   do {                                                                        \
-      if (unlikely(pan_device((ctx)->base.screen)->debug & PAN_DBG_FORCE_PACK)) \
-         mesa_logw(__VA_ARGS__);                                               \
-      util_debug_message(&ctx->base.debug, INFO, __VA_ARGS__);                 \
-   } while (0)
-
 #endif /* PAN_SCREEN_H */
-- 
